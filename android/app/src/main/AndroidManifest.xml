<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- GLES2 — SDL_Renderer's Android backend -->
    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true">

        <!-- Launcher. On a fresh install no ROM has been imported yet, so
             this shows the native "Select your ROM" screen and installs the
             picked dump into the app's files dir before starting the game.
             Once a ROM is present it starts TMCActivity directly. Keeping the
             first-run prompt in Java (not the in-engine prelaunch) means a
             fresh install never depends on the native UI coming up, and the
             game Activity still owns the display routing below. -->
        <activity
            android:name="dev.picori.tmc.TMCSetupActivity"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="dev.picori.tmc.TMCActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>

        <!-- The panel's host for the swapped layout: it takes the main
             display while the game runs on the secondary one. Its own task
             (required to launch onto a chosen display), and resizable so
             the framework will place it on another display at all. -->
        <activity
            android:name="dev.picori.tmc.SecondScreenActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
    </application>

</manifest>
